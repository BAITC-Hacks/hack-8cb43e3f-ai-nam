# All files and results are stored on this computer by default.
AI_NAM_HOST=127.0.0.1
AI_NAM_PORT=8765
# none | ollama | compatible
AI_PROVIDER=ollama
AI_BASE_URL=http://127.0.0.1:11434
AI_MODEL=qwen2.5:7b
AI_API_KEY=
AI_MAX_PAIRS=20
AI_TIMEOUT_SECONDS=180
# For HTTPS behind a reverse proxy, set secure session cookies.
AI_NAM_SECURE_COOKIES=false
# Comma-separated hostnames accepted by the app. Add your LAN hostname/IP.
AI_NAM_ALLOWED_HOSTS=127.0.0.1,localhost
# When using HTTPS reverse proxy, set its exact public origin (without path).
# AI_NAM_PUBLIC_ORIGIN=https://ai-nam.internal
# Optional alternative directory for local data.
# AI_NAM_DATA_DIR=./data
