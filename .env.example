# Скопируйте в .env и при необходимости измените:  cp .env.example .env
# Все параметры необязательны — без .env система запускается с безопасными значениями по умолчанию.

# ---------------------------------------------------------------- доступ
# Первичный администратор (создаётся при первом запуске; пароль смените после входа)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
# Секрет для подписи токенов. Пусто — сгенерируется и сохранится в DATA_DIR/.secret
SECRET_KEY=
# Демо-пользователи (analyst@example.com / analyst12345, viewer@example.com / viewer12345) и демо-проект
SEED_DEMO=true

# ---------------------------------------------------------------- ИИ-модель
# none   — работа без модели: правила + текстовое сходство + шаблоны (все функции доступны)
# openai — любой OpenAI-совместимый сервер: Ollama, LM Studio, vLLM, llama.cpp, OpenAI, OpenRouter и т.д.
# Эти значения — стартовые; их можно поменять в панели администратора (раздел «ИИ-модель»).
LLM_PROVIDER=none

# Ollama на хосте:                http://localhost:11434/v1        (из Docker: http://host.docker.internal:11434/v1)
# Ollama в docker compose:        http://ollama:11434/v1           (docker compose --profile ollama up -d)
# LM Studio:                      http://localhost:1234/v1
# vLLM:                           http://localhost:8001/v1   (vllm serve … --port 8001)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
# Текстовая модель (проверка выводов, резюме заключения, ответы на вопросы)
LLM_MODEL=qwen2.5:7b-instruct
# Vision-модель для распознавания схем с фото (необязательно; без неё работает OpenCV + Tesseract)
LLM_VISION_MODEL=
# Embedding-модель для семантического сходства функций (необязательно; например bge-m3)
LLM_EMBED_MODEL=
LLM_TIMEOUT=180
LLM_TEMPERATURE=0.1

# ---------------------------------------------------------------- хранение
# Каталог данных (БД SQLite, загруженные файлы, сформированные документы)
# DATA_DIR=./data
# PostgreSQL вместо SQLite (необязательно, нужен пакет psycopg[binary]): postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL=
MAX_UPLOAD_MB=50

# ---------------------------------------------------------------- OCR
# Путь к tesseract, если он не в PATH (Windows: C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=
OCR_LANGS=rus+kaz+eng

# ---------------------------------------------------------------- прочее
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
